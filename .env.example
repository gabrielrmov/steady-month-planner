# PostgreSQL (Neon, conexão "pooled")
DATABASE_URL=

# Assina o cookie de sessão. 32+ caracteres aleatórios (ex.: openssl rand -hex 32)
SESSION_SECRET=

# Login com Google (Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth, "Aplicativo da Web")
# Origem autorizada: o valor de APP_URL. Redirecionamento: APP_URL/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Endereço público do site, sem barra final. Em desenvolvimento: http://localhost:3000
APP_URL=

# Open Finance (Pluggy), opcional. Somente no servidor.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
